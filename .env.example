# Copy to .env (never committed) or export in the environment of the server.
# Where HTTP responses are cached, with their fetch date.
FONCIER_MCP_CACHE_DIR=~/.cache/foncier-mcp
# Cache lifetime in hours (default 168, one week).
FONCIER_MCP_CACHE_TTL_HOURS=168
# 1 = serve only from the cache, never call the network (used by tests and offline evals).
FONCIER_MCP_OFFLINE=0
# HTTP transport only: require an API key on every call.
FONCIER_MCP_REQUIRE_API_KEY=1
# Where issued API keys and daily usage counters live (JSON files, outside the repo).
FONCIER_MCP_KEYS_FILE=~/.config/foncier-mcp/keys.json
FONCIER_MCP_USAGE_FILE=~/.config/foncier-mcp/usage.json
# Hosted mode without a disk: the output of `foncier-mcp keys export`, as a secret variable.
# When set, the key store is read-only and FONCIER_MCP_KEYS_FILE is ignored.
FONCIER_MCP_KEYS_JSON=
# Free tier quota, calls per key per UTC day.
FONCIER_MCP_FREE_DAILY_QUOTA=200
# Paid tier: designed, counted, but switched off. Do not turn on without the legal clearance described in the README.
PAID_TIER_ENABLED=false
FONCIER_MCP_PAID_DAILY_QUOTA=5000
# HTTP transport only: key-less public demo route POST /demo/summary (summarize_parcel only).
FONCIER_MCP_DEMO=0
# Browser origins allowed to call the demo (CORS), comma-separated.
FONCIER_MCP_DEMO_ORIGINS=https://guillaume-couillard.com
# Demo limits: per client address per hour, and for everyone per UTC day.
FONCIER_MCP_DEMO_HOURLY_PER_IP=10
FONCIER_MCP_DEMO_DAILY_CAP=300
# HTTP transport only: comma-separated host names accepted in the Host header (DNS rebinding
# protection). Empty = accept any host, which a public deployment behind a proxy needs.
FONCIER_MCP_ALLOWED_HOSTS=
